{
  // Cloudflare Workers static site. "name" must match the Worker's name in the Cloudflare dashboard.
  // Build command: npm run build    Deploy command: npx wrangler deploy
  "name": "fluidweb",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Only dist/ is published, so server/, tools/, README.md and site.config.json stay private.
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
